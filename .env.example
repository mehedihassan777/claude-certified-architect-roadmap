# Supabase: Project Settings → API Keys. Copy to .env.local for `npm run dev`; on Vercel, add
# them under Project → Settings → Environment Variables and redeploy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only; bypasses row-level security. Needed only by the admin page. Never prefix it with
# NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_...

# Your own user ID (Supabase → Authentication → Users → the UID column), after you register.
# That account, and only that one, can open /admin.
ADMIN_USER_ID=
