# Where progress.json lives: "file" (default; VPS or Docker) or "github" (Vercel or Netlify,
# where the runtime filesystem is read-only).
STORAGE_DRIVER=file

# file driver. Relative paths resolve from the app's working directory.
PROGRESS_FILE_PATH=./data/progress.json

# github driver: progress.json lives in a SEPARATE private repo, so progress commits
# don't trigger redeploys of this app.
# GITHUB_TOKEN=     # fine-grained PAT with Contents: read and write on that repo only
# GITHUB_REPO=      # owner/name, e.g. your-user/cca-progress
# GITHUB_BRANCH=main
# GITHUB_PROGRESS_PATH=progress.json
